{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v graphify >/dev/null 2>&1 || uv tool install graphifyy >/dev/null 2>&1 || pipx install graphifyy >/dev/null 2>&1 || pip install --user graphifyy >/dev/null 2>&1 || true",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
